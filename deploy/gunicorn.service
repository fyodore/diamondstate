[Unit]
Description=Diamond State Softball League Gunicorn
After=network.target

[Service]
User=www-data
Group=www-data
WorkingDirectory=/opt/dssl/backend
EnvironmentFile=/opt/dssl/.env
ExecStart=/opt/dssl/.venv/bin/gunicorn \
    --workers 3 \
    --bind 127.0.0.1:8000 \
    config.wsgi:application
Restart=always

[Install]
WantedBy=multi-user.target
