# Leave DATABASE_URL empty to use local SQLite for quick development
CORS_ALLOWED_ORIGINS=http://localhost:5173,http://127.0.0.1:5173,https://diamondstatesoftball.org,http://diamondstatesoftball.org
CSRF_TRUSTED_ORIGINS=http://localhost:5173,http://127.0.0.1:5173,https://diamondstatesoftball.org,http://diamondstatesoftball.org,https://api.diamondstatesoftball.org,http://api.diamondstatesoftball.org
WEBAUTHN_RP_ID=diamondstatesoftball.org
WEBAUTHN_RP_NAME=Diamond State Softball League
WEBAUTHN_ORIGIN=https://diamondstatesoftball.org
MEDIA_URL=/media/
STATIC_URL=/static/
