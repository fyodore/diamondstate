"""
Local / server-only Django overrides.

Copy this file to settings_local.py and fill in real values:

    cp config/settings_local.py.example config/settings_local.py

settings_local.py is gitignored and must never be committed.
Any names set here override the defaults in settings.py.
"""

# SECURITY
SECRET_KEY = "replace-with-a-long-random-secret"
DEBUG = False
ALLOWED_HOSTS = [
    "api.diamondstatesoftball.org",
    "diamondstatesoftball.org",
    "localhost",
    "127.0.0.1",
]

# Database (Postgres on the server)
DATABASES = {
    "default": {
        "ENGINE": "django.db.backends.postgresql",
        "NAME": "dssl",
        "USER": "dssl",
        "PASSWORD": "replace-with-db-password",
        "HOST": "127.0.0.1",
        "PORT": "5432",
    }
}

# Cross-origin frontend (apex site calling api subdomain)
CORS_ALLOWED_ORIGINS = [
    "https://diamondstatesoftball.org",
    "http://diamondstatesoftball.org",
]
CORS_ALLOW_CREDENTIALS = True

CSRF_TRUSTED_ORIGINS = [
    "https://diamondstatesoftball.org",
    "http://diamondstatesoftball.org",
    "https://api.diamondstatesoftball.org",
    "http://api.diamondstatesoftball.org",
]

# Share session/CSRF cookies across apex + api subdomain
SESSION_COOKIE_DOMAIN = ".diamondstatesoftball.org"
CSRF_COOKIE_DOMAIN = ".diamondstatesoftball.org"
SESSION_COOKIE_SECURE = True
CSRF_COOKIE_SECURE = True

# Passkeys / WebAuthn (use the public site origin, not the API host)
WEBAUTHN_RP_ID = "diamondstatesoftball.org"
WEBAUTHN_RP_NAME = "Diamond State Softball League"
WEBAUTHN_ORIGIN = "https://diamondstatesoftball.org"

